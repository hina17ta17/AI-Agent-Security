# Copy to .env.local for local development. On Cloud Run these are service environment variables.

# Firebase web app config (public client identifiers, served to the browser at runtime by /api/config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Server-side settings
PROJECT_ID=
TARGET_URL=https://target-<PROJECT_NUMBER>.<REGION>.run.app
KMS_KEY=projects/<PROJECT_ID>/locations/<REGION>/keyRings/byok/cryptoKeys/tenant-gemini-key
