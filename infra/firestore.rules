rules_version = '2';

// AgentGuard Firestore rules.
// - Browsers may only READ their own tenant's data (live dashboard).
// - Every write goes through the server (Admin SDK bypasses these rules).
// - Outside tenants/{uid} (tenantSecrets = encrypted Gemini API keys, ingestKeys, siteClaims,
//   status, config): no client access at all. An account's own usage counts are under its tenant.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // "Sign out everywhere" writes tenants/{uid}.sessionsValidAfter (a Unix time in seconds).
    // Sessions whose sign-in happened before that moment can no longer read anything.
    // Missing document or missing field -> 0, so normal accounts are unaffected.
    function sessionStart() {
      return request.auth.token.auth_time;
    }

    function cutoffFor(database, uid) {
      return exists(/databases/$(database)/documents/tenants/$(uid))
        ? get(/databases/$(database)/documents/tenants/$(uid)).data.get('sessionsValidAfter', 0)
        : 0;
    }

    match /tenants/{uid} {
      allow read: if isOwner(uid)
        && (resource == null || sessionStart() >= resource.data.get('sessionsValidAfter', 0));
      allow write: if false;

      match /{sub=**} {
        allow read: if isOwner(uid) && sessionStart() >= cutoffFor(database, uid);
        allow write: if false;
      }
    }

    // Deny everything else, including tenantSecrets/{uid}.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
