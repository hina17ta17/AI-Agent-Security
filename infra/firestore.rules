rules_version = '2';

// AgentGuard Firestore rules.
// - Browsers may only READ their own tenant's data (live dashboard).
// - Every write goes through the server (Admin SDK bypasses these rules).
// - tenantSecrets (encrypted Gemini API keys), sites, usage: no client access at all.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /tenants/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{sub=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Deny everything else, including tenantSecrets/{uid}.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
